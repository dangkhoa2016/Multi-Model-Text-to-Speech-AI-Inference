# Example structure only. Never commit real tokens, Fernet keys or URLs.
# Modal Secret: text-to-speech-api-authentication — HTTP gateway ONLY.
TEXT_TO_SPEECH_CLIENT_KEY_HASHES_JSON={"rails-app":"<64_lowercase_sha256_hex>"}
TEXT_TO_SPEECH_OWNER_TOKEN_SHA256=<64_lowercase_sha256_hex_for_separate_operator_token>
TEXT_TO_SPEECH_REVOKED_CLIENT_IDS=

# Modal Secret: text-to-speech-job-database — HTTP gateway and CPU dispatcher ONLY.
TEXT_TO_SPEECH_POSTGRESQL_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@DB_HOST/DB_NAME?sslmode=require
TEXT_TO_SPEECH_FERNET_ENCRYPTION_KEY=<persistent_fernet_key>
TEXT_TO_SPEECH_MAX_PENDING_JOBS_PER_CLIENT=20
TEXT_TO_SPEECH_MAX_PENDING_JOBS_PER_MODEL=20
TEXT_TO_SPEECH_COMPLETED_JOB_RETENTION_DAYS=7
# Optional GLOBAL PostgreSQL GPU admission estimates, not actual provider billing.
# Configure BOTH in the job-database Secret or leave both absent.
# TEXT_TO_SPEECH_ESTIMATED_GPU_USD_PER_JOB=0.15
# TEXT_TO_SPEECH_MAX_ESTIMATED_GPU_USD_PER_DAY=5.00

# Modal Secret: text-to-speech-rate-limiting — HTTP gateway ONLY.
TEXT_TO_SPEECH_REDIS_CONNECTION_URL=rediss://USERNAME:PASSWORD@REDIS_HOST:6379/0
TEXT_TO_SPEECH_REDIS_RATE_LIMIT_NAMESPACE=tts-v1
TEXT_TO_SPEECH_RATE_PREAUTH_REQUESTS_PER_PEER_PER_MINUTE=120
TEXT_TO_SPEECH_RATE_PREAUTH_REQUESTS_GLOBAL_PER_MINUTE=600
TEXT_TO_SPEECH_AUTHENTICATION_FAILURE_LIMIT=3
TEXT_TO_SPEECH_AUTHENTICATION_FAILURE_WINDOW_SECONDS=300
TEXT_TO_SPEECH_AUTHENTICATION_LOCKOUT_SECONDS=900
TEXT_TO_SPEECH_RATE_MAX_JOBS_PER_WINDOW=12
TEXT_TO_SPEECH_RATE_JOBS_WINDOW_SECONDS=300
TEXT_TO_SPEECH_RATE_MAX_JOBS_PER_CLIENT_PER_DAY=100
TEXT_TO_SPEECH_RATE_MAX_JOBS_GLOBAL_PER_DAY=500
TEXT_TO_SPEECH_RATE_MAX_POLLS_PER_MINUTE=120

# Modal Secret: text-to-speech-hugging-face-authentication — CPU downloads/checks ONLY.
# Create a Hugging Face read token for an account with permission to read gated models.
HUGGING_FACE_READ_TOKEN=<hugging_face_read_token>
# Alternative Secret key: HF_TOKEN=<hugging_face_read_token>
# When both are present, HUGGING_FACE_READ_TOKEN wins.
# Optional CPU-download acceleration: HF_XET_HIGH_PERFORMANCE=1 (default off).
# This can increase CPU, memory, disk I/O, network use and infrastructure cost.

# Optional deployment-time GPU choices (not secrets).
MOSS_TTS_GPU_TYPE=L40S
HIGGS_TTS_3_GPU_TYPE=L40S
VOXCPM2_GPU_TYPE=L40S
# Explicit acknowledgement only after a legitimate Higgs model license review.
HIGGS_TTS_3_LICENSE_CONFIRMED=0


# Reference voice cloning is OFF in production unless explicitly approved.
# This is an access switch, not a substitute for consent verification/moderation.
TEXT_TO_SPEECH_ENABLE_REFERENCE_VOICE_CLONING=0
# Requires both global opt-in and one or more separately approved active client IDs.
TEXT_TO_SPEECH_REFERENCE_VOICE_CLONING_CLIENT_IDS_JSON=[]

# CPU-only operator monitor: off (default) or hourly, captured when deploying.
TEXT_TO_SPEECH_OPERATIONS_MONITOR_SCHEDULE=off

# Choose GPU backends in one place on the deploy machine (NOT in a Modal Secret).
# Default is empty: no model accepts jobs until you select it.
# Available IDs: moss-tts-v1.5,voxcpm2,higgs-tts-3
TEXT_TO_SPEECH_ENABLED_MODELS=moss-tts-v1.5,voxcpm2
# Hash-locked MOSS and VoxCPM2 dependencies build automatically when selected.
# Checkpoint integrity and MOSS codec manifests are verified by workers at startup.
# No GPU_ACCEPTED, CODEC_READY, build-approval or package-version flags are needed.
# Separately licensed Higgs remains the ONLY consumer of an immutable
# upstream OCI SGLang image. Never use the mutable :dev tag.
# TEXT_TO_SPEECH_SGLANG_OMNI_IMAGE_REF=lmsysorg/sglang-omni@sha256:<audited_digest>
# Optional operator-approved immutable Hugging Face revisions, captured at deploy.
# TEXT_TO_SPEECH_MOSS_TTS_REVISION_SHA=<verified_40_hex_commit>
# TEXT_TO_SPEECH_HIGGS_TTS_3_REVISION_SHA=<verified_40_hex_commit>
# TEXT_TO_SPEECH_VOXCPM2_REVISION_SHA=<verified_40_hex_commit>
